    "@types/webpack-env": "~1.15.2",
    "ajv": "^8.20.0",
    "css-loader": "~7.1.2",
    "eslint": "9.37.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "tsx": "^4.23.15",
    "typescript": "~5.8.0",
