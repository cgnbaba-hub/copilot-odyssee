{
  "name": "odyssee-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.14.0 < 23.0.0"
  },
  "scripts": {
    "content:check": "tsx tools/content-cli.ts check",
    "content:bundle": "tsx tools/content-cli.ts bundle",
    "content:export": "tsx tools/content-cli.ts export",
    "prebuild": "npm run content:bundle",
    "build": "heft test --clean --production && heft package-solution --production",
    "test": "npm run content:bundle && heft test --clean",
    "clean": "heft clean",
    "eject-webpack": "heft eject-webpack",
    "prestart": "npm run content:bundle",
    "start": "heft start --clean",
    "predemo": "npm run content:bundle",
    "demo": "vite",
    "predemo:build": "npm run content:bundle",
    "demo:build": "vite build"
  },
  "dependencies": {
    "@fluentui/react": "^8.106.4",
